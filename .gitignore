# Dependencies
node_modules/

# Build output (regenerated by `npm run build`)
dist/

# The original 8192² San Francisco textures (~2.4 GB / 332 MB). The streamed
# city under assets/city/ is the baked replacement; assets/sanfranscisco/ must
# NEVER be loaded at runtime and must never enter the repo history.
assets/sanfranscisco/

# Unreferenced loose car models — the game loads jesko/source/Koenigsegg_OnePlus.fbx.
assets/cars/bolide.fbx
assets/cars/Pagani.fbx
assets/cars/ferrari.fbx
assets/cars/Pagani Zonda R 2009.fbx

# Unreferenced jet audio — the engine uses the two .wav files in assets/sound/.
assets/sound/322178__ikbenraar__f16-fighter-jet-start-up.aiff

# Editor / OS cruft
.DS_Store
Thumbs.db
*.log

# Environment / secrets
.env
.env.*
!.env.example
